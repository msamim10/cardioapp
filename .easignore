# Files uploaded to EAS Build should be limited to what the native build needs.
# This mirrors .gitignore and additionally excludes repo docs/scratch that are
# irrelevant to compiling the iOS app. Do NOT exclude assets/, app.json, source,
# package.json, package-lock.json, or metro/expo config — the build needs them.

# Local env files (never uploaded; values come from eas.json `env` / EAS env vars)
.env
.env.*
!.env.example

# Project documentation & handoff notes (not needed by the build)
docs/
*.md
!README.md

# Editor / OS cruft
.vscode/
.idea/
.DS_Store

# Agent / assistant scratch
.claude/
.cursor/

# Generated native folders (managed workflow — regenerated by prebuild on EAS)
/ios
/android
