# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# --- additions for standalone repo init ---

# env files (full set — existing rule only covered *.local)
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*
!.env.example

# service-account keys / large media staging live OUTSIDE the repo; never commit
*serviceaccount*.json
*-admin.json

# Singular SDK keys — local, gitignored. Copy singularConfig.example.ts →
# singularConfig.ts and fill in real keys (or use EXPO_PUBLIC_SINGULAR_* env).
src/lib/singularConfig.ts

# editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Python bytecode from the asset-slicing scripts in scripts/
__pycache__/
*.pyc

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini

# scratch / temp / backups
*.tmp
*.bak
*.old

# JetBrains / Gradle / native caches (in case prebuild is run later)
*.iml
.gradle/

# generic logs not covered above
*.log
