# ---------------------------------------------------------------------------
# CardioSurf environment configuration (copy to `.env` and fill in real values)
# All keys are read at build time via `process.env.EXPO_PUBLIC_*`.
# `.env` is gitignored; this `.env.example` is committed with placeholders only.
# ---------------------------------------------------------------------------

# --- Media / HLS video hosting -------------------------------------------
# Root URL of the Firebase Storage (GCS) bucket that hosts the HLS videos.
# Use the GCS public form (NOT firebasestorage.googleapis.com), because HLS
# playlists use relative segment paths that only resolve with real slashes.
#
#   EXPO_PUBLIC_MEDIA_BASE_URL=https://storage.googleapis.com/<your-bucket>
#
# The app streams each level from:
#   <BASE>/hls/level<N>/<vertical|horizontal>/master.m3u8
# Leave empty until the bucket is set up; the app treats videos as unavailable.
EXPO_PUBLIC_MEDIA_BASE_URL=

# --- Workout pose tracking -----------------------------------------------
# Real tracking is the default on a physical iOS dev/production build when
# the local CardioSurfPose native module is present. Explicitly enable the
# clearly labeled simulator for development screenshots only (production
# builds ignore this flag; simulation never starts automatically):
# EXPO_PUBLIC_POSE_TRACKING_MODE=demo
EXPO_PUBLIC_POSE_TRACKING_MODE=

# --- Firebase Auth + Firestore -------------------------------------------
# Public web-client config from Firebase Console -> Project settings ->
# Your apps -> CardioSurf. These values identify the client; they are not
# admin credentials and are safe to embed in the app.
EXPO_PUBLIC_FIREBASE_API_KEY=PLACEHOLDER_FIREBASE_WEB_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=PLACEHOLDER_FIREBASE_AUTH_DOMAIN
EXPO_PUBLIC_FIREBASE_PROJECT_ID=PLACEHOLDER_FIREBASE_PROJECT_ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=PLACEHOLDER_FIREBASE_STORAGE_BUCKET
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=PLACEHOLDER_FIREBASE_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=PLACEHOLDER_FIREBASE_APP_ID

# --- RevenueCat (in-app subscriptions) -----------------------------------
# Create a NEW RevenueCat app for CardioSurf (dashboard -> Project -> Apps).
# These are the PUBLIC SDK keys (safe on-device).
#
# Key resolution (see src/lib/config.ts):
#   1. Platform key for the current OS (appl_ on iOS / goog_ on Android) if set
#      to a real, non-placeholder value.
#   2. Otherwise the platform-agnostic key EXPO_PUBLIC_REVENUECAT_KEY.
# This lets a RevenueCat Test Store key (test_ prefix) work today while real
# store keys drop in later without any code changes.
#   iOS  key looks like:   appl_XXXXXXXXXXXXXXXXXXXXXXXXX
#   Android key looks like: goog_XXXXXXXXXXXXXXXXXXXXXXXXX
#   Test Store key looks like: test_XXXXXXXXXXXXXXXXXXXXXXXXX
# The app only calls RevenueCat when a real (non-placeholder) key is present.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_PLACEHOLDER_IOS_SDK_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_PLACEHOLDER_ANDROID_SDK_KEY
EXPO_PUBLIC_REVENUECAT_KEY=test_PLACEHOLDER_UNIFIED_SDK_KEY

# Entitlement identifier configured in RevenueCat (Project -> Entitlements).
# CardioSurf gates Pro content on this entitlement. This MUST match the exact
# identifier you create in the RevenueCat dashboard (case + spaces matter).
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=cardioapp_pro

# --- Google Sign-In (@react-native-google-signin/google-signin) ----------
# Use CardioSurf OAuth clients only; never copy IDs from an unrelated app.
#   - Web client ID -> MUST match Firebase Console -> Authentication ->
#     Sign-in method -> Google -> Web SDK configuration. It is passed as
#     `webClientId` and determines the ID-token audience Firebase accepts.
#   - iOS client ID -> passed as `iosClientId`; register the matching bundle ID
#     in the same Firebase/Google Cloud project as the web/server client.
#   - Android client ID -> registered with your SHA-1; not passed in JS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=PLACEHOLDER-web.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=PLACEHOLDER-ios.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=PLACEHOLDER-android.apps.googleusercontent.com

# --- Singular attribution + analytics (singular-react-native) -------------
# CLIENT SDK credentials from the Singular dashboard: Developer Tools -> SDK
# Keys. Both are embedded in the app (not server/admin secrets) but must never
# be committed. Consumed by src/lib/singularConfig.ts (which is gitignored) and
# surfaced to the SDK via src/lib/singular.ts. Attribution/analytics no-op until
# BOTH are real (non-placeholder) values.
EXPO_PUBLIC_SINGULAR_SDK_KEY=PLACEHOLDER_SINGULAR_SDK_KEY
EXPO_PUBLIC_SINGULAR_SDK_SECRET=PLACEHOLDER_SINGULAR_SDK_SECRET

# WHO reports the canonical `sng_start_trial` / `sng_subscribe` events. Exactly
# one source may own them or Singular double-counts every purchase.
#   client     (default) - this app sends them, with revenue, from the Singular
#                          SDK. Required for Singular accounts created on or
#                          after 2026-07-15: those use Singular's Event API v2 /
#                          Singular Device ID, which RevenueCat's integration
#                          does not support, so RevenueCat delivers nothing.
#   revenuecat           - RevenueCat's server integration owns them; this app
#                          emits only non-revenue `client_*` diagnostics. Switch
#                          to this BEFORE enabling that integration, not after.
EXPO_PUBLIC_SINGULAR_REVENUE_SOURCE=client

# Whether a trial start carries a revenue amount (only used when the line above
# is `client`).
#   none  (default) - plain event, as Singular's subscription guide prescribes:
#                     a trial has produced no money yet.
#   price           - revenue event worth the product's full price, which makes
#                     trial starts biddable as revenue in ad networks, at the
#                     cost of booking revenue that may never arrive and
#                     counting a converting trial's price twice.
EXPO_PUBLIC_SINGULAR_TRIAL_START_REVENUE=none

# The iOS reversed-client-id URL scheme lives in app.json under the
# @react-native-google-signin/google-signin plugin `iosUrlScheme` and must match
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID. Changing either requires a fresh native build.
#
# NOTE: native config files GoogleService-Info.plist (iOS) and
# google-services.json (Android) are only required if you add Firebase or want
# Google to be auto-configured. They are gitignored — download your OWN from the
# Google/Firebase console; do NOT reuse another app's files.
