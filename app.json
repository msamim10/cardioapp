{
  "expo": {
    "name": "CardioSurf",
    "slug": "cardiosurf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cardiosurf",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.cardiosurf.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "SKAdNetworkItems": [
          { "SKAdNetworkIdentifier": "v9wttpbfk9.skadnetwork" },
          { "SKAdNetworkIdentifier": "n38lu8286q.skadnetwork" },
          { "SKAdNetworkIdentifier": "238da6jt44.skadnetwork" },
          { "SKAdNetworkIdentifier": "22mmun2rn5.skadnetwork" }
        ]
      }
    },
    "android": {
      "package": "com.cardiosurf.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CardioSurf uses the camera to track your full-body movement so your real workout controls the game. Video stays on your device and is never recorded or uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-video",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.41005114333-ioq5d0bijpd1vgfn13411sdtqnglkn09"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "singular-react-native",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "CardioSurf uses this to measure ad performance and connect you to the campaign that brought you here. Your data is never sold."
        }
      ],
      "./plugins/withNoApsEnvironment",
      "./plugins/withStoreKitConfig"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e1c66d70-af99-43c3-8f96-60d1f1b90362"
      }
    },
    "owner": "mezzdev"
  }
}
