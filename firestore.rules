rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // --- Private per-user progress (unchanged) ---------------------------
    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);

      // Following list: owner writes, any signed-in user may read (the
      // Friends tab of another user's board, follower counts later).
      match /following/{targetUid} {
        allow read: if signedIn();
        allow create, update: if isOwner(uid)
          && targetUid != uid
          && request.resource.data.keys().hasOnly(['uid', 'at'])
          && request.resource.data.uid == targetUid;
        allow delete: if isOwner(uid);
      }

      match /{document=**} {
        allow read, create, update, delete: if isOwner(uid);
      }
    }

    // Support submissions: authenticated users may create their own message.
    // Reads/updates/deletes are owner-only via the Firebase console (never client).
    match /supportMessages/{messageId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000;
      allow read, update, delete: if false;
    }

    // --- Public profile ------------------------------------------------------
    // Anyone signed in can read. The owner writes presentation fields only;
    // `username` is written exclusively by the reserveUsername Function so the
    // usernames/ registry stays authoritative.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && !('username' in request.resource.data)
        && request.resource.data.keys().hasOnly(['photoURL', 'level', 'badges', 'hudTheme', 'updatedAt']);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['username'])
        && request.resource.data.keys().hasOnly(['username', 'photoURL', 'level', 'badges', 'hudTheme', 'updatedAt']);
      allow delete: if false;
    }

    // --- Leaderboards + beat-my-score (Functions write, clients read) ---------
    match /leaderboards/{levelId} {
      allow read: if signedIn();
      allow write: if false;
      match /entries/{uid} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
    match /dailyLeaderboards/{dateKey} {
      allow read: if signedIn();
      allow write: if false;
      match /entries/{uid} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
    match /challenges/{runId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /beatmaps/{levelId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /usernames/{handle} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Server-only bookkeeping: nonces, audit trail, rate limits.
    match /runNonces/{nonce} {
      allow read, write: if false;
    }
    match /submissions/{runId} {
      allow read, write: if false;
    }
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
